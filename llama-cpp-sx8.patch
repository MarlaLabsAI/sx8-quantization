+            if (step0 < 1e-10f) step0 = 1e-10f;
+            const float w0 = rlo0 + step0 * (float)lv0;
+
+            // peso j1
+            const int hi1 = (bq->qh[j1 >> 1] >> ((j1 & 1) * 4)) & 0xF;
+            const int lo1 = (bq->ql[j1 >> 2] >> ((3 - (j1 & 3)) * 2)) & 0x3;
+            const int lv1 = (hi1 << 2) | lo1;
+            const int s1  = (cfg >> ((j1 >> 3) * 2)) & 3;
+            const float rlo1 = lo_f + q * (float)(3 * (s1 == 2) + (s1 == 3));
+            const float rhi1 = hi_f - q * (float)(3 * (s1 == 1) + (s1 == 3));
+            float step1 = (rhi1 - rlo1) * 0.015873f;
+            if (step1 < 1e-10f) step1 = 1e-10f;
+            const float w1 = rlo1 + step1 * (float)lv1;
+
+            x_qs[i*MMQ_MMA_TILE_X_K_SX8 + k2] = __floats2half2_rn(w0, w1);
+        }
+    }
