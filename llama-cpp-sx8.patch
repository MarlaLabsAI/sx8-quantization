+template <int mmq_y, bool need_check> static __device__ __forceinline__ void load_tiles_sx8(
+    const char * __restrict__ x, int * __restrict__ x_tile, const int kbx0, const int i_max, const int stride) {
+    constexpr int nwarps = mmq_get_nwarps_device();
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+
+    half2 * x_qs = (half2 *) x_tile;
+
+    // 8 bloques de 32 pesos por fila (ITER_K = 256) -> 128 half2 por fila
+    // 32 threads: cada thread escribe 4 half2 (posiciones c*32+txi), cada half2 = 2 pesos consecutivos
+    constexpr int threads_per_row = 32;
+    constexpr int nrows = warp_size / threads_per_row;
+    const int txi = warp_size > threads_per_row ? threadIdx.x % threads_per_row : threadIdx.x;
+    const int row_in_warp = warp_size > threads_per_row ? threadIdx.x / threads_per_row : 0;
+
+#pragma unroll
+    for (int i0 = 0; i0 < mmq_y; i0 += nrows*nwarps) {
+        int i = i0 + (nrows == 1 ? threadIdx.y : threadIdx.y*nrows + row_in_warp);
+
+        if (need_check) {
+            i = min(i, i_max);
+        }
+
+        const block_sx8 * bxi = (const block_sx8 *) x + kbx0 + i*stride;
+
+#pragma unroll
+        for (int c = 0; c < 4; ++c) {
+            const int k2 = c*32 + txi;   // indice half2 (0..127) = pesos (2*k2, 2*k2+1)
+            const int b  = k2 >> 4;      // bloque (0..7): 16 half2 por bloque
+            const int j0 = 2*(k2 & 15);  // peso par dentro del bloque (0..30)
+            const int j1 = j0 + 1;       // peso impar (1..31)
+
+            const block_sx8 * bq = bxi + b;
+
+            const float lo_f = __half2float(bq->dmin);
+            const float hi_f = __half2float(bq->dmax);
+            const float q = (hi_f - lo_f) * 0.25f;
+            const uint8_t cfg = bq->config;
+
+            // peso j0
+            const int hi0 = (bq->qh[j0 >> 1] >> ((j0 & 1) * 4)) & 0xF;
+            const int lo0 = (bq->ql[j0 >> 2] >> ((3 - (j0 & 3)) * 2)) & 0x3;
+            const int lv0 = (hi0 << 2) | lo0;
+            const int s0  = (cfg >> ((j0 >> 3) * 2)) & 3;
+            const float rlo0 = lo_f + q * (float)(3 * (s0 == 2) + (s0 == 3));
+            const float rhi0 = hi_f - q * (float)(3 * (s0 == 1) + (s0 == 3));
