+#define VDR_SX8_Q8_1_MMQ  8
+
+static __device__ __forceinline__ float vec_dot_sx8_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_sx8 * bq = (const block_sx8 *) vbq + kbx;
+
+    const float lo_f = __half2float(bq->dmin);
+    const float hi_f = __half2float(bq->dmax);
+    const float q = (hi_f - lo_f) * 0.25f;
+    const uint8_t cfg = bq->config;
+    const float yd = __low2float(bq8_1->ds);
+    const float ys = __high2float(bq8_1->ds);
+    const float ym = ys / (float) QK8_1;
+
+    // Leccion v8 del proyecto: iqs siempre es multiplo de 8 (kqs = vdr*(tid%4)),
+    // asi que cada llamada cubre EXACTAMENTE un sub-bloque de 8 pesos con un unico (rlo, step).
+    const int s_ = (cfg >> ((iqs >> 3) * 2)) & 3;
+    const float rlo = lo_f + q * (float)(3 * (s_ == 2) + (s_ == 3));
+    const float rhi = hi_f - q * (float)(3 * (s_ == 1) + (s_ == 3));
+    float step = (rhi - rlo) * 0.015873f;
+    if (step < 1e-10f) step = 1e-10f;
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int i = 0; i < VDR_SX8_Q8_1_MMVQ; ++i) {
+        const int j = iqs + i;
+        const int hi = (bq->qh[j >> 1] >> ((j & 1) * 4)) & 0xF;
+        const int lo = (bq->ql[j >> 2] >> ((3 - (j & 3)) * 2)) & 0x3;
+        const int lv = (hi << 2) | lo;
+        const float w = rlo + step * (float)lv;
+        const float yv = (float) bq8_1->qs[j] * yd + ym;
+        sumf += w * yv;
+    }
+    return sumf;
+}
