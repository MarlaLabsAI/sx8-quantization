+// S-X8 v4.3 (Marla Labs): decode V6 — mismo que kernel_sx8_v43.py (2 FMAs,
+// estrategias sin branches, sin PCA en llama.cpp — el coeff se ignora).
+void dequantize_row_sx8(const block_sx8 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    static const int qk = QKSX8;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float lo_f = GGML_FP16_TO_FP32(x[i].dmin);
+        const float hi_f = GGML_FP16_TO_FP32(x[i].dmax);
+        const float q = (hi_f - lo_f) * 0.25f;
+        const uint8_t cfg = x[i].config;
+        for (int j = 0; j < qk; ++j) {
+            const int hi = (x[i].qh[j >> 1] >> ((j & 1) * 4)) & 0xF;
+            const int lo = (x[i].ql[j >> 2] >> ((3 - (j & 3)) * 2)) & 0x3;
+            const int lv = (hi << 2) | lo;
+            const int s = (cfg >> ((j >> 3) * 2)) & 3;
+            const float rlo = lo_f + q * (float)(3 * (s == 2) + (s == 3));
+            const float rhi = hi_f - q * (float)(3 * (s == 1) + (s == 3));
+            float step = (rhi - rlo) * 0.015873f;
+            if (step < 1e-10f) step = 1e-10f;
+            y[i*qk + j] = rlo + step * (float)lv;
+        }
+    }
+}
+
+void quantize_row_sx8_ref(const float * GGML_RESTRICT x, block_sx8 * GGML_RESTRICT y, int64_t k) {
+    static const int qk = QKSX8;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        float lo_f = x[i*qk + 0], hi_f = x[i*qk + 0];
+        for (int j = 1; j < qk; ++j) {
+            lo_f = MIN(lo_f, x[i*qk + j]);
+            hi_f = MAX(hi_f, x[i*qk + j]);
+        }
+        y[i].dmin = GGML_FP32_TO_FP16(lo_f);
+        y[i].dmax = GGML_FP32_TO_FP16(hi_f);
+        const float q = (hi_f - lo_f) * 0.25f;
+        uint8_t cfg = 0;
+        for (int sb = 0; sb < 4; ++sb) {
+            // elegir la estrategia de menor error por sub-bloque (MSE con 4 rangos)
+            const float lo_c[4] = { lo_f, lo_f, hi_f - q, lo_f + q };
+            const float hi_c[4] = { hi_f, lo_f + q, hi_f, hi_f - q };
+            float best = 1e30f;
+            int s = 0;
+            for (int c = 0; c < 4; ++c) {
+                const float step = (hi_c[c] - lo_c[c]) / 63.0f;
+                if (step <= 0.0f) continue;
+                float err = 0.0f;
+                for (int j = 0; j < 8; ++j) {
+                    const float v = x[i*qk + sb*8 + j];
+                    float lvf = roundf((v - lo_c[c]) / step);
+                    int lv = (int)(lvf < 0 ? 0 : (lvf > 63 ? 63 : lvf));
+                    const float rec = lo_c[c] + step * lv;
+                    err += (v - rec) * (v - rec);
+                }
+                if (err < best) { best = err; s = c; }
+            }
+            cfg |= (uint8_t)s << (sb * 2);
+        }
+        y[i].config = cfg;
+        for (int j = 0; j < qk; ++j) {
+            const int s = (cfg >> ((j >> 3) * 2)) & 3;
+            const float rlo = lo_f + q * (float)(3 * (s == 2) + (s == 3));
+            const float rhi = hi_f - q * (float)(3 * (s == 1) + (s == 3));
+            float step = (rhi - rlo) / 63.0f;
+            if (step < 1e-10f) step = 1e-10f;
+            float lvf = roundf((x[i*qk + j] - rlo) / step);
+            const int lv = (int)(lvf < 0 ? 0 : (lvf > 63 ? 63 : lvf));
+            const int hi = lv >> 2;
+            const int lo = lv & 3;
+            const int mask_hi = 0xF << ((j & 1) * 4);
+            const int mask_lo = 0x3 << ((3 - (j & 3)) * 2);
+            y[i].qh[j >> 1] = (uint8_t)((y[i].qh[j >> 1] & ~mask_hi) | ((hi & 0xF) << ((j & 1) * 4)));
+            y[i].ql[j >> 2] = (uint8_t)((y[i].ql[j >> 2] & ~mask_lo) | ((lo & 0x3) << ((3 - (j & 3)) * 2)));
+        }
+        y[i].coeff = 0;  // PCA no usado en llama.cpp
+    }
+}
