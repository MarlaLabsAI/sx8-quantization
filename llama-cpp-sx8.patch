+    const int * __restrict__ x, const int * __restrict__ y, float * __restrict__ sum, const int k00) {
+    // mma m16n8k16.f32.f16.f16.f32: A = 16x8 half2 (M16 x K16 halfs), B = 8x8 half2 (K16 x N8), D = 16x8 float
+    typedef tile<16, 8, half2> tile_A;
+    typedef tile< 8, 8, half2> tile_B;
+    typedef tile<16, 8, float> tile_C;
+
+    constexpr int granularity = mmq_get_granularity_device(mmq_x);
+    constexpr int rows_per_warp = 2 * granularity;
+    constexpr int ntx = rows_per_warp / tile_C::I;
+
+    y += (threadIdx.y % ntx) * (tile_C::J * MMQ_TILE_Y_K);
+
+    const half2 * x_qs = (const half2 *) x;
+    const int   * y_qs = (const int *) y + 4;
+    const float * y_df = (const float *) y;
+
+    const int i0 = (threadIdx.y / ntx) * rows_per_warp;
+
+    // k00 ∈ {0, 32}: offset en half2s del tile_x (0 o 64 half2 = 128 halfs = 128 pesos)
+    const int k0 = k00 * 2;
+
+    // 128 pesos por llamada = 8 tiles A de K16 halfs (8 half2 por tile)
+    for (int k01 = 0; k01 < 64; k01 += 8) {
+        const int k = k0 + k01;
+
+        tile_A A[ntx];
+#pragma unroll
+        for (int n = 0; n < ntx; ++n) {
+            load_generic(A[n], x_qs + (i0 + n*tile_A::I)*MMQ_MMA_TILE_X_K_SX8 + k, MMQ_MMA_TILE_X_K_SX8);
+        }
+
+
+#pragma unroll
+        for (int j0 = 0; j0 < mmq_x; j0 += ntx*tile_C::J) {
+            tile_B B;
+
+            // Fragmento B (m16n8k16.f16): B.x[l] = (B[k][n], B[k][n+1]) con
+            //   k = get_i(l) + 8*(get_j(l)>>2), n = 2*(get_j(l)&3)
+            // El half2 = 2 columnas consecutivas N al mismo K.
+#pragma unroll
+            for (int l = 0; l < tile_B::ne; ++l) {
+                // Fragmento B (m16n8k16.f16): B.x[l] = half2(B[K][N], B[K+1][N]) con
+                //   K = 2*get_j(l), N = get_i(l) — el half2 = 2 K consecutivas a la misma N
+                const int kk = k01*2 + 2*tile_B::get_j(l);   // K local (0..126, par) del bloque_y
+                const int n  = j0 + tile_B::get_i(l);        // columna N
